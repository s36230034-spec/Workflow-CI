name: telco-churn-ci

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      data_path: {type: string, default: "telco_preprocessing/telco_churn_clean.csv"}
      n_estimators: {type: int, default: 200}
      max_depth: {type: int, default: 20}
    command: "python modelling.py --data_path {data_path} --n_estimators {n_estimators} --max_depth {max_depth}"
